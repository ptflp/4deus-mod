#!/usr/bin/python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


RUNNER_VERSION = 1
PROFILE_ID_PATTERN = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
ELF_MAGIC = b"\x7fELF"
ELF_CLASS_32 = 1
ELF_CLASS_64 = 2


def matching_processes(pattern: str) -> set[int]:
    matches: set[int] = set()
    own_pid = os.getpid()
    for process in Path("/proc").iterdir():
        if not process.name.isdigit():
            continue
        pid = int(process.name)
        if pid == own_pid:
            continue
        try:
            if process.stat().st_uid != os.getuid():
                continue
            command = (process / "cmdline").read_bytes().replace(b"\0", b" ")
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if pattern.encode() in command:
            matches.add(pid)
    return matches


def load_profile(profile_id: str) -> dict:
    if not PROFILE_ID_PATTERN.fullmatch(profile_id):
        raise ValueError("invalid profile ID")
    path = (
        Path.home()
        / ".local/share/4deus-mod/app-bridge/profiles"
        / f"{profile_id}.json"
    )
    profile = json.loads(path.read_text(encoding="utf-8"))
    if profile.get("version") != RUNNER_VERSION:
        raise ValueError("unsupported profile version")
    command = profile.get("command")
    if (
        not isinstance(command, list)
        or not command
        or not all(isinstance(part, str) and part for part in command)
    ):
        raise ValueError("invalid command")
    return profile


def elf_class(path: Path) -> int | None:
    try:
        header = path.read_bytes()[:5]
    except OSError:
        return None
    if len(header) != 5 or not header.startswith(ELF_MAGIC):
        return None
    return header[4] if header[4] in (ELF_CLASS_32, ELF_CLASS_64) else None


def is_steam_overlay(path: Path) -> bool:
    return (
        path.name == "gameoverlayrenderer.so"
        and path.parent.name in {"ubuntu12_32", "ubuntu12_64"}
    )


def sanitize_steam_overlay_preload(
    environment: dict[str, str],
    command: list[str],
) -> None:
    preload = environment.get("LD_PRELOAD")
    target_class = elf_class(Path(command[0])) if command else None
    if not preload or target_class is None:
        return

    compatible: list[str] = []
    for value in re.split(r"[:\s]+", preload):
        if not value:
            continue
        path = Path(value)
        preload_class = elf_class(path)
        if (
            is_steam_overlay(path)
            and preload_class is not None
            and preload_class != target_class
        ):
            continue
        compatible.append(value)

    if compatible:
        environment["LD_PRELOAD"] = ":".join(compatible)
    else:
        environment.pop("LD_PRELOAD", None)


def nested_desktop_runtime(
    environment: dict[str, str],
) -> Path | None:
    authority_value = environment.get("XAUTHORITY")
    current_runtime_value = environment.get("XDG_RUNTIME_DIR")
    if not authority_value or not current_runtime_value:
        return None

    authority = Path(authority_value)
    current_runtime = Path(current_runtime_value)
    if not authority.is_absolute() or not current_runtime.is_absolute():
        return None

    runtime = authority.parent
    if (
        not runtime.name.startswith("nested-desktop.")
        or runtime not in (current_runtime, current_runtime / runtime.name)
    ):
        return None

    try:
        if (
            not authority.is_file()
            or not runtime.is_dir()
            or authority.stat().st_uid != os.getuid()
            or runtime.stat().st_uid != os.getuid()
        ):
            return None
    except OSError:
        return None

    wayland_display = environment.get("WAYLAND_DISPLAY")
    if wayland_display:
        display_path = Path(wayland_display)
        if display_path.is_absolute():
            socket_path = display_path
        elif len(display_path.parts) == 1:
            socket_path = runtime / display_path
        else:
            return None
        try:
            if socket_path.parent != runtime or not socket_path.is_socket():
                return None
        except OSError:
            return None

    return runtime


def build_environment(profile: dict) -> dict[str, str]:
    environment = os.environ.copy()
    if profile.get("clearSteamPreload"):
        environment.pop("LD_PRELOAD", None)
        environment.pop("LD_AUDIT", None)
    elif profile.get("sanitizeSteamOverlay"):
        sanitize_steam_overlay_preload(
            environment,
            profile.get("command", []),
        )
    library_path = profile.get("libraryPath")
    if isinstance(library_path, str) and library_path:
        current = environment.get("LD_LIBRARY_PATH", "")
        environment["LD_LIBRARY_PATH"] = (
            f"{library_path}:{current}" if current else library_path
        )
    if profile.get("forceX11"):
        environment.setdefault("DISPLAY", ":0")
        environment["XDG_SESSION_TYPE"] = "x11"
        environment["XDG_CURRENT_DESKTOP"] = "gamescope"
        environment["XDG_SESSION_DESKTOP"] = "gamescope"
    if profile.get("useNestedDesktopRuntime"):
        runtime = nested_desktop_runtime(environment)
        if runtime is not None:
            environment["XDG_RUNTIME_DIR"] = str(runtime)
            environment["XDG_CURRENT_DESKTOP"] = "KDE"
    return environment


def wait_for_tracked_process(
    launcher: subprocess.Popen,
    pattern: str,
) -> int:
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if matching_processes(pattern):
            break
        if launcher.poll() is not None:
            time.sleep(0.2)
        else:
            time.sleep(0.1)
    else:
        return launcher.wait() if launcher.poll() is None else launcher.returncode

    while matching_processes(pattern):
        time.sleep(1)
    if launcher.poll() is None:
        try:
            return launcher.wait(timeout=2)
        except subprocess.TimeoutExpired:
            return 0
    return launcher.returncode


def run(profile_id: str) -> int:
    profile = load_profile(profile_id)
    log_dir = Path.home() / ".local/share/4deus-mod/app-bridge/logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / f"{profile_id}.log"
    working_directory = profile.get("workingDirectory")
    if not isinstance(working_directory, str) or not Path(
        working_directory
    ).is_dir():
        working_directory = str(Path.home())

    with log_path.open("a", encoding="utf-8") as log:
        print(
            f"\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] launch requested",
            file=log,
            flush=True,
        )
        environment = build_environment(profile)
        if profile.get("useNestedDesktopRuntime"):
            runtime = nested_desktop_runtime(environment)
            status = str(runtime) if runtime is not None else "not detected"
            print(
                f"nested desktop runtime: {status}",
                file=log,
                flush=True,
            )
        launcher = subprocess.Popen(
            profile["command"],
            cwd=working_directory,
            env=environment,
            stdout=log,
            stderr=subprocess.STDOUT,
        )
        pattern = profile.get("waitForProcess")
        if isinstance(pattern, str) and pattern:
            return wait_for_tracked_process(launcher, pattern)
        return launcher.wait()


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("usage: 4deus-app-bridge <profile-id>")
        raise SystemExit(run(sys.argv[1]))
    except Exception as error:
        print(f"4deus App Bridge: {error}", file=sys.stderr)
        raise SystemExit(1)
